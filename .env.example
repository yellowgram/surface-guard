# GitHub App credentials (never commit real values)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./app-private-key.pem
# Or inline PEM with literal \n sequences:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace_with_long_random_secret

# HTTP
PORT=3080
HOST=127.0.0.1

# Billing entitlement store (fail-closed if org not listed)
# Comma-separated org logins that are currently entitled (founding / paid).
# Production should replace this with Polar/Stripe-backed store.
SURFACE_GUARD_ENTITLED_ORGS=

# Paths inside the customer private repo (file-mode SurfacePin verify)
SURFACE_GUARD_LOCKFILE_PATH=surfacepin.lock.json
# Required for real verify — surface dump JSON (tools/list or combined surfaces)
SURFACE_GUARD_SURFACE_PATH=tools.json

# Emergency only — forces fail-closed stub verify (never invent success)
# SURFACE_GUARD_STUB_VERIFY=1
